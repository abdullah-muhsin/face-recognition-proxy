# Copy to a protected deployment environment. Do not commit real values.
GATEWAY_LISTEN_ADDRESS=:8080
DATABASE_URL=postgres://pushsdk:CHANGE_ME@postgres:5432/pushsdk?sslmode=disable
GATEWAY_TERMINALS_FILE=/run/gateway/terminals.json
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
COOKIE_SECURE=true
SESSION_TTL=12h
WEB_DIR=/app/web
MIGRATIONS_DIR=/app/migrations
# Private monitoring IP ranges only; do not include 0.0.0.0/0. The Docker
# bridge range is required because host loopback traffic reaches the container
# from its bridge gateway.
METRICS_ALLOW_CIDRS=127.0.0.1/32,172.16.0.0/12
