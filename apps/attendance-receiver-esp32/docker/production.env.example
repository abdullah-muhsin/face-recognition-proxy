# Copy this file to .env.production before deploying.
# Use the public HTTPS URL that ESP32 bridges will use.
APP_NAME="Attendance Receiver"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://attendance.example.com
SESSION_SECURE_COOKIE=true

# Use a long random value and configure the same value on every ESP32 bridge.
ATTENDANCE_BRIDGE_TOKEN=

# Gateway-to-Laravel secret for the direct Hikvision Push SDK path. This must
# be at least 32 characters, different from ATTENDANCE_BRIDGE_TOKEN, and is
# never configured on a terminal.
ATTENDANCE_PUSH_GATEWAY_TOKEN=

# Laravel rejects pictures larger than this value. nginx must allow a larger
# request body to account for HTTP framing.
ATTENDANCE_PICTURE_MAX_BYTES=2097152
