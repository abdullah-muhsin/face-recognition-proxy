# Copy to .env.production. Docker Compose supplies these values to the gateway.
PUSHSDK_GATEWAY_BIND_ADDRESS=127.0.0.1
PUSHSDK_GATEWAY_HOST_PORT=8100
PUSHSDK_GATEWAY_CONFIG_FILE=/absolute/path/to/gateway.json
PUSHSDK_GATEWAY_RUNTIME_ENV_FILE=.env.production

# This must exactly match the password configured on the terminal's Push SDK page.
PUSHSDK_TERMINAL_PASSWORD=

# This must exactly match ATTENDANCE_PUSH_GATEWAY_TOKEN in the Laravel receiver runtime environment.
ATTENDANCE_PUSH_GATEWAY_TOKEN=

# Add one variable for every additional terminal password named by gateway.json.
