# Local development defaults. Production uses docker/production.env.example.
APP_NAME="Attendance Receiver"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# SQLite uses database/database.sqlite by default.
DB_CONNECTION=sqlite

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Set the same secret on the ESP32 bridge when API authentication is enabled.
ATTENDANCE_BRIDGE_TOKEN=

# Required only when the dedicated Push SDK gateway is deployed.
ATTENDANCE_PUSH_GATEWAY_TOKEN=
ATTENDANCE_PICTURE_MAX_BYTES=2097152
