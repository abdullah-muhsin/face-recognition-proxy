# Copy this file to .env.production before deploying.
# Operator-facing URL for this demo receiver.
APP_NAME="Push SDK Attendance Demo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://attendance.example.com
SESSION_SECURE_COOKIE=true

# Gateway-to-Laravel secret for the direct Hikvision Push SDK path. It must be
# at least 32 characters and is never configured on a terminal.
ATTENDANCE_PUSH_GATEWAY_TOKEN=

# Laravel rejects pictures larger than this value. nginx must allow a larger
# request body to account for HTTP framing.
ATTENDANCE_PICTURE_MAX_BYTES=2097152
