# Local development defaults. Production uses docker/production.env.example.
APP_NAME="Push SDK Attendance Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# SQLite uses database/database.sqlite by default.
DB_CONNECTION=sqlite

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Required. This is only for the private Push SDK gateway-to-Laravel hop.
ATTENDANCE_PUSH_GATEWAY_TOKEN=
ATTENDANCE_PICTURE_MAX_BYTES=2097152
