# Stored on the VPS only as /home/abdullah/pushsdk-gateway-runtime/gateway.env
# Permissions: owner read/write only. This file is a template, not a runtime input.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_DATABASE_PASSWORD
DATABASE_URL=postgres://pushsdk:REPLACE_WITH_A_LONG_UNIQUE_DATABASE_PASSWORD@postgres:5432/pushsdk?sslmode=disable
ADMIN_USERNAME=REPLACE_WITH_OPERATOR_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_OPERATOR_PASSWORD
COOKIE_SECURE=true
SESSION_TTL=12h
METRICS_ALLOW_CIDRS=127.0.0.1/32,172.16.0.0/12

# Optional event delivery. Set matching key ID and key in the receiving tenant.
# Key values are exactly 64 lowercase hexadecimal characters, generated securely.
DELIVERY_SIGNING_KEYS={}
