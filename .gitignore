# Terminal connection details and deployment credentials are local-only.
/config/terminals.json
.env
/web/node_modules/
/web/dist/

# Vendor SDKs and documentation are local protocol references, not application
# source. They may contain release bundles, certificates, local databases, and
# machine-specific build outputs.
/third_party/

docs/**/credentials.local.md
docs/**/.env.local

# Workstation copies of production credentials. These files must never be
# committed, archived with source bundles, or served by an application.
/.local-secrets/
